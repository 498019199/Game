find_program(DOTNET_EXECUTABLE dotnet HINTS "$ENV{DOTNET_ROOT}" "${CMAKE_CURRENT_SOURCE_DIR}/.dotnet" REQUIRED)
get_filename_component(DOTNET_REAL_EXECUTABLE "${DOTNET_EXECUTABLE}" REALPATH)
get_filename_component(DOTNET_ROOT "${DOTNET_REAL_EXECUTABLE}" DIRECTORY)

if(CMAKE_SYSTEM_NAME STREQUAL "Darwin")
    set(DOTNET_OS osx)
elseif(WIN32)
    set(DOTNET_OS win)
else()
    set(DOTNET_OS linux)
endif()
if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(arm64|aarch64)$")
    set(DOTNET_ARCH arm64)
elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|AMD64|amd64)$")
    set(DOTNET_ARCH x64)
else()
    message(FATAL_ERROR "Unsupported native architecture: ${CMAKE_SYSTEM_PROCESSOR}")
endif()
set(DOTNET_RID "${DOTNET_OS}-${DOTNET_ARCH}")
file(GLOB HOST_PACKS LIST_DIRECTORIES true
    "${DOTNET_ROOT}/packs/Microsoft.NETCore.App.Host.${DOTNET_RID}/10.*/runtimes/${DOTNET_RID}/native")
list(SORT HOST_PACKS COMPARE NATURAL ORDER DESCENDING)
if(NOT HOST_PACKS)
    message(FATAL_ERROR "Install the .NET 10 SDK for ${DOTNET_RID}; hosting pack not found under ${DOTNET_ROOT}")
endif()
list(GET HOST_PACKS 0 DOTNET_HOST_PACK)
message(STATUS "Using .NET hosting pack: ${DOTNET_HOST_PACK}")

# Do not inherit the engine's shared output directory: isolated builds must not
# replace binaries another agent may be running.
set(CMAKE_RUNTIME_OUTPUT_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/bin")
set(CMAKE_ARCHIVE_OUTPUT_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/lib")
foreach(configuration DEBUG RELEASE RELWITHDEBINFO MINSIZEREL)
    set(CMAKE_RUNTIME_OUTPUT_DIRECTORY_${configuration} "${CMAKE_CURRENT_BINARY_DIR}/bin")
    set(CMAKE_ARCHIVE_OUTPUT_DIRECTORY_${configuration} "${CMAKE_CURRENT_BINARY_DIR}/lib")
endforeach()
set(MANAGED_OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/managed")
set(SERVER_OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/server")
