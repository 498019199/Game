add_library(gameplay_dotnet_host STATIC client/DotnetHost.cpp client/GameSession.cpp)
set_target_properties(gameplay_dotnet_host PROPERTIES POSITION_INDEPENDENT_CODE ON)
target_compile_definitions(gameplay_dotnet_host PRIVATE
    GAMEPLAY_DOTNET_ROOT="${DOTNET_ROOT}" GAMEPLAY_MANAGED_DIR="${MANAGED_OUTPUT}")
target_include_directories(gameplay_dotnet_host PUBLIC client PRIVATE "${DOTNET_HOST_PACK}")
target_compile_features(gameplay_dotnet_host PUBLIC cxx_std_17)
if(WIN32)
    set(NETHOST_LIBRARY "${DOTNET_HOST_PACK}/nethost.lib")
else()
    # Static nethost has a macOS RTTI collision with std::exception.
    set(NETHOST_LIBRARY "${DOTNET_HOST_PACK}/${CMAKE_SHARED_LIBRARY_PREFIX}nethost${CMAKE_SHARED_LIBRARY_SUFFIX}")
endif()
target_link_libraries(gameplay_dotnet_host PUBLIC gameplay_protocol PRIVATE "${NETHOST_LIBRARY}" ${CMAKE_DL_LIBS})
add_executable(gameplay_client client/main.cpp)
target_link_libraries(gameplay_client PRIVATE gameplay_dotnet_host)
add_dependencies(gameplay_client gameplay_managed)
if(WIN32)
    add_custom_command(TARGET gameplay_client POST_BUILD COMMAND "${CMAKE_COMMAND}" -E copy_if_different
        "${DOTNET_HOST_PACK}/nethost.dll" "$<TARGET_FILE_DIR:gameplay_client>" VERBATIM)
endif()
