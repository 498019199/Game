<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- No third-party packages. .NET 10 may restore the official .NET
       Standard 2.1 reference pack from NuGet on first build. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
