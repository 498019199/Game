<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ProtocolGeneratedDir Condition="'$(ProtocolGeneratedDir)' == ''">$(MSBuildThisFileDirectory)protocol/generated</ProtocolGeneratedDir>
  </PropertyGroup>
</Project>
